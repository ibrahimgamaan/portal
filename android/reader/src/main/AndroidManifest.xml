<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <queries><package android:name="app.masrouf"/></queries>
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:supportsRtl="true" android:allowBackup="false">
        <activity android:name=".MainActivity" android:exported="true" android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
        <receiver android:name=".SmsForwarder" android:exported="true" android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="100"><action android:name="android.provider.Telephony.SMS_RECEIVED"/></intent-filter>
        </receiver>
    </application>
</manifest>
